rule "remove fields with $5s not relevant to USC"
when
exists "5**"
then
addSubField "5**.5.TEMP" if (not exists "5**.5.*")
removeField "5**" if (not exists "5**.5.CLSU|CaLa*|CLSU*|TEMP*")
removeSubField "5**.5" if (exists "5**.5.TEMP")
end

